{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.*.example)",
      "Read(**/*secret*)",
      "Read(**/*token*)",
      "Read(**/*credential*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(rawdata/**)",
      "Read(cleaned/**)",
      "Read(cost/**)",
      "Read(private/**)",
      "Read(//**/_VAULT/**)",
      "Read(**/data.js)",
      "Read(**/*.xlsx)",
      "Read(**/*.xlsm)",
      "Read(**/*.csv)",
      "Read(**/*.sqlite)",
      "Read(**/*.db)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(!.env.*.example)",
      "Edit(**/*secret*)",
      "Edit(**/*token*)",
      "Edit(**/*credential*)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(rawdata/**)",
      "Edit(cleaned/**)",
      "Edit(cost/**)",
      "Edit(private/**)",
      "Edit(//**/_VAULT/**)",
      "Edit(**/data.js)",
      "Edit(**/*.xlsx)",
      "Edit(**/*.csv)",
      "Edit(**/*.sqlite)",
      "Edit(**/*.db)",
      "Bash(cat *.env*)",
      "Bash(cat *secret*)",
      "Bash(cat *token*)",
      "Bash(cat *credential*)",
      "Bash(cat *_VAULT*)",
      "Bash(cat *rawdata/*)",
      "Bash(cat *private/*)",
      "Bash(cat *cost/*)",
      "Bash(cat *cleaned/*)",
      "Bash(cat *.xlsx)",
      "Bash(cat *.csv)",
      "Bash(cat *data.js)",
      "Bash(type *.env*)",
      "Bash(type *secret*)",
      "Bash(type *_VAULT*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(strings *.env*)",
      "Bash(xxd *.env*)",
      "Bash(od *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Get-Content *secret*)",
      "PowerShell(Get-Content *token*)",
      "PowerShell(Get-Content *credential*)",
      "PowerShell(Get-Content *_VAULT*)",
      "PowerShell(Get-Content *rawdata*)",
      "PowerShell(Get-Content *private*)",
      "PowerShell(Get-Content *cost*)",
      "PowerShell(Get-Content *cleaned*)",
      "PowerShell(Get-Content *.xlsx)",
      "PowerShell(Get-Content *.csv)",
      "PowerShell(Get-Content *data.js)"
    ]
  }
}
